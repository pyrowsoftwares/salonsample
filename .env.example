# Environment variables configuration example for Aurel Studio
# Copy this file to .env.local for local overrides

# Set to 'production' for live domain, or 'preview' for client demo
NEXT_PUBLIC_ENVIRONMENT=preview

# Salon WhatsApp Number with Country Code (e.g., +919876543210)
# Leave empty to keep in "Online appointment requests coming soon" preview mode
NEXT_PUBLIC_SALON_WHATSAPP=

# Salon Official Contact Telephone
NEXT_PUBLIC_SALON_PHONE=

# External Booking Engine URL (Optional: e.g., Zenoti, Fresha, Luzo)
# If provided, CTAs can route to this direct booking integration
NEXT_PUBLIC_EXTERNAL_BOOKING_URL=

# Production Domain Canonical Base (e.g., https://aurelstudio.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
